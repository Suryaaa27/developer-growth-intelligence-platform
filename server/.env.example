# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# Reverse Proxy Trust (1 for single hop on cloud platforms like Render; defaults to 1 when NODE_ENV=production)
# TRUST_PROXY=1

# Rate Limiting Configuration (Defaults: Login=10/15min, Register=5/15min)
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=900000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=developer_growth_db

# MySQL SSL/TLS Configuration (Required for cloud-managed databases like Aiven, PlanetScale, AWS RDS)
# Set DB_SSL=true in production for encrypted database transport. Defaults to false for local development.
DB_SSL=false
# Optional: Custom CA certificate file path (e.g. for Aiven, AWS RDS bundle)
# DB_SSL_CA_PATH=/path/to/ca.pem
# Optional: Custom CA certificate inline PEM string
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# JWT Authentication (Used for signing user session tokens; independent from token encryption when GITHUB_TOKEN_ENCRYPTION_KEY is configured)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# GitHub Token Encryption - Primary Key (Used for all new token encryptions. 64-char hex or passphrase string; defaults to SHA-256(JWT_SECRET) if unset)
# GITHUB_TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here

# GitHub Token Encryption - Legacy Migration Key (Optional temporary decryption-only key for zero-downtime production migrations)
# Decryption priority order:
#   1. GITHUB_TOKEN_ENCRYPTION_KEY
#   2. GITHUB_TOKEN_ENCRYPTION_LEGACY_KEY (if configured)
#   3. SHA-256(JWT_SECRET) (if configured)
# Must be exactly 64 hexadecimal characters representing an already-derived 32-byte key (e.g. previous environment's SHA-256(JWT_SECRET)).
# GITHUB_TOKEN_ENCRYPTION_LEGACY_KEY=your_64_char_hex_legacy_key_here

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# GitHub API (For future steps)
# GITHUB_TOKEN=your_github_personal_access_token_here
